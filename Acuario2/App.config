<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <!--
      Cadena de conexión a MySQL.
      Si no se configura una BD, el sistema funcionará automáticamente en modo local/offline
      (Usuario: admin / Clave: admin).

      Para conectar con tu base de datos:
      - Aiven Cloud:
        Server=TU_HOST;Port=20847;Database=defaultdb;Uid=TU_USUARIO;Pwd=TU_CLAVE;SslMode=Required;ConnectionTimeout=20;
      - Local (XAMPP / WAMP / MySQL Server):
        Server=localhost;Port=3306;Database=defaultdb;Uid=root;Pwd=;SslMode=None;ConnectionTimeout=20;
    -->
    <connectionStrings>
        <add name="AcuarioDB"
             connectionString="Server=TU_HOST;Port=20847;Database=defaultdb;Uid=TU_USUARIO;Pwd=TU_CLAVE;SslMode=Required;ConnectionTimeout=20;"
             providerName="MySql.Data.MySqlClient" />
    </connectionStrings>
</configuration>
